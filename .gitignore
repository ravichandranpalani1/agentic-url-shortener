# Build output (compiled classes, generated source-list files) -- see scripts/build.sh
out/

# Local data directory the service writes its write-ahead log into when DATA_DIR is not overridden
/data/

# OS / editor cruft
.DS_Store
*.swp
# Maven build output for service/ (compiled classes, the packaged jar, surefire reports)
service/target/
# Git bundle files used for one-off transport of commits -- never part of the project itself
*.bundle
